# Copy to .env (git-ignored). Values below match docker-compose.yml + testdata/;
# they are throwaway credentials for the local Docker MySQL only.
# Load in bash:       set -a; source .env; set +a
# Load in PowerShell: see README "Local development / testing"

# Host port of the Docker MySQL (change if 3306 is taken on your machine,
# and adjust the ports in the DSNs below accordingly).
SQIT_MYSQL_PORT=3306

# LOCAL database = working tree (read/write user)
SQIT_LOCAL_DSN='sqit_local_user:sqit_local_pw@tcp(127.0.0.1:3306)/sqit_local'

# UPSTREAM database = plays the TEST role (SELECT-only user)
SQIT_TEST_DSN='sqit_upstream_user:sqit_upstream_pw@tcp(127.0.0.1:3306)/sqit_upstream'

# Refuse any upstream that is not on localhost (belt and braces while testing).
SQIT_LOCAL_ONLY=1

# Root DSN for the Go integration tests (they create/drop sqit_it_* databases).
SQIT_IT_DSN='root:sqit-root@tcp(127.0.0.1:3306)/'
